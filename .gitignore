# Build and dependencies
build/
node_modules/
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.py[cod]

# Data: the downloaded sources and everything tools/data/build_all.sh generates from them.
# The build needs only src/lang/*/dict.json. Kept: the description, the hand-made seed
# lists (data/seed/) and two references for npm test (tests/morph.mjs).
data/*
!data/README*.md
!data/seed/
!data/morph/
data/morph/*
!data/morph/verified_adj.tsv
!data/exceptions/
data/exceptions/*
!data/exceptions/adj_rule_mismatches.tsv
# English: the same rule — only the description and the hand-made seed lists.
!data/en/
data/en/*
!data/en/README*.md
!data/en/seed/
# Generated by tools/data/gen_templates.py
Templates.txt

